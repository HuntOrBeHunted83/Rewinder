{
  "name": "Changing History",
  "description": "A way to see how the website looks in the past",
  "version": "1.0",
  "manifest_version": 3,
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://archive.org/*",
    "https://web.archive.org/*"
  ],
  "side_panel": {
    "default_path": "popup.html"
  },
  "action": {}
}